{
  "expo": {
    "name": "Fixfly Pro",
    "slug": "fixfly",
    "owner": "zerodaysoftware",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1117",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.fixfly.pro",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Fixfly Pro uses the camera so you can photograph a fault and attach proof when resolving a task.",
        "NSPhotoLibraryUsageDescription": "Fixfly Pro needs photo access so you can attach existing photos to a task or chat message.",
        "NSFaceIDUsageDescription": "Fixfly Pro uses Face ID to unlock the app quickly instead of typing your password."
      }
    },
    "android": {
      "package": "io.fixfly.pro",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0D1117",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fixfly Pro needs photo access so you can attach existing photos to a task or chat message.",
          "cameraPermission": "Fixfly Pro uses the camera so you can photograph a fault and attach proof when resolving a task."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Fixfly Pro uses Face ID to unlock the app quickly instead of typing your password."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0ACC6B",
          "defaultChannel": "default",
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "335082e9-4908-42ef-b5f4-ccc3eb6dd2eb"
      }
    }
  }
}
